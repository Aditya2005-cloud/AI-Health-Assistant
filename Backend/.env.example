# ==========================================================
# AI Health Assistant — Environment Variables Template
# ==========================================================
# Copy this file to Backend/.env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore.

# ── Flask ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_STRING
FLASK_DEBUG=True

# ── MySQL Database ──────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=ai_health_assistant

# ── JWT Authentication ──────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_STRING
JWT_EXPIRES_DAYS=7

# ── Google Gemini ───────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ── Groq ────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gmail Email Service (optional — app works without it) ───
# Step 1: Enable 2-Step Verification on your Google Account
# Step 2: Visit https://myaccount.google.com/apppasswords
# Step 3: Generate an App Password for Mail → copy the 16-char code
GMAIL_SENDER_ADDRESS=YOUR_GMAIL_ADDRESS@gmail.com
GMAIL_APP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
GMAIL_SENDER_NAME=AI Health Assistant
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_TIMEOUT=30
GMAIL_SILENT_FAIL=True

# ── Medicine Reminder Scheduler ──────────────────────────────────
# How often (in minutes) the scheduler checks for pending reminders
REMINDER_INTERVAL=1
